<Window x:Class="Panak.Views.FolderLockSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="clr-namespace:Panak.Markup"
        Title="Կողպել պանակը - Panak"
        Height="540" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Material You Dynamic Brushes -->
        <SolidColorBrush x:Key="M3SurfaceBrush" Color="#FEF4EB"/>
        <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#FCDDC5"/>
        <SolidColorBrush x:Key="M3CardBrush" Color="#FFF7F0"/>
        <SolidColorBrush x:Key="M3PrimaryBrush" Color="#7A5427"/>
        <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#FEF4EB"/>
        <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#2B1D11"/>
        <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#6E5643"/>
        <SolidColorBrush x:Key="M3TrackInactiveBrush" Color="#EED7C5"/>
        <SolidColorBrush x:Key="M3ErrorBrush" Color="#BA1A1A"/>

        <!-- Action Button Style (M3 Expressive Pill) -->
        <Style x:Key="DialogActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static markup:HalfToCornerRadiusConverter.Instance}}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style (M3 Expressive Pill Tonal) -->
        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static markup:HalfToCornerRadiusConverter.Instance}}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M3 Expressive PasswordBox Style -->
        <Style x:Key="M3ExpressivePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource M3TrackInactiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource M3CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pattern Matrix Dot Button Style -->
        <Style x:Key="PatternMatrixButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Radio Style -->
        <Style x:Key="LockMethodRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource M3SurfaceBrush}" CornerRadius="22" BorderBrush="Transparent" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="DialogTitleText" Text="Կողպել պանակը" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock x:Name="FolderSubtitleText" Text="Պանակի անվտանգության կարգավորումներ" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="{DynamicResource M3OnSurfaceBrush}" BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click" FontSize="12" FontWeight="Bold"/>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" Focusable="False">
                <StackPanel>
                    <!-- Current Status Banner if Locked -->
                    <Border x:Name="CurrentLockBanner" Background="{DynamicResource M3CardBrush}" CornerRadius="12" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Պանակն այժմ կողպված է" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                <TextBlock x:Name="CurrentLockDetailsText" Text="Կողպման եղանակ՝ Գաղտնաբառ" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <Button x:Name="RemoveLockBtn" Grid.Column="1" Content="Հեռացնել" Style="{StaticResource DialogSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="RemoveLockBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Lock Type Selector -->
                    <TextBlock Text="Ընտրեք կողպման եղանակը" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,14">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="MethodPasswordRadio" Style="{StaticResource LockMethodRadioStyle}" Content="🔑 Գաղտնաբառ" IsChecked="True" Checked="MethodRadio_Checked"/>
                            <RadioButton x:Name="MethodPinRadio" Style="{StaticResource LockMethodRadioStyle}" Content="🔢 PIN" Checked="MethodRadio_Checked"/>
                            <RadioButton x:Name="MethodPatternRadio" Style="{StaticResource LockMethodRadioStyle}" Content="⭕ Նախշ" Checked="MethodRadio_Checked"/>
                        </UniformGrid>
                    </Border>

                    <!-- Method Panels -->
                    <!-- 1. Password Inputs -->
                    <StackPanel x:Name="PanelPassword" Margin="0,0,0,10">
                        <TextBlock Text="Նոր գաղտնաբառ" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="InputPassword" Style="{StaticResource M3ExpressivePasswordBoxStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Հաստատեք գաղտնաբառը" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="InputConfirmPassword" Style="{StaticResource M3ExpressivePasswordBoxStyle}"/>
                    </StackPanel>

                    <!-- 2. PIN Inputs -->
                    <StackPanel x:Name="PanelPin" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="PIN կոդ" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="InputPin" Style="{StaticResource M3ExpressivePasswordBoxStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Հաստատեք PIN կոդը" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="InputConfirmPin" Style="{StaticResource M3ExpressivePasswordBoxStyle}"/>
                    </StackPanel>

                    <!-- 3. Pattern Inputs (Drag-to-Draw) -->
                    <StackPanel x:Name="PanelPattern" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Քաշեք մկնիկով՝ նախշի հաջորդականությունը գծելու համար" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource M3CardBrush}" CornerRadius="16" Padding="12" HorizontalAlignment="Center">
                            <StackPanel>
                                <Canvas x:Name="SetupPatternCanvas" Width="180" Height="180" Background="Transparent" ClipToBounds="False"
                                        PreviewMouseDown="SetupPatternCanvas_MouseDown"
                                        PreviewMouseMove="SetupPatternCanvas_MouseMove"
                                        PreviewMouseUp="SetupPatternCanvas_MouseUp"
                                        MouseLeave="SetupPatternCanvas_MouseLeave"/>
                                <TextBlock x:Name="SetupPatternSequenceText" Text="Ընտրված կետեր՝ (չկա)" FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <Button Content="Մաքրել" HorizontalAlignment="Center" Margin="0,6,0,0" Background="Transparent" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" BorderThickness="0" Cursor="Hand" Click="SetupPatternClear_Click" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Error Badge -->
                    <Border x:Name="DialogErrorBadge" Background="#25FF0000" CornerRadius="8" Padding="10,6" Margin="0,4,0,4" Visibility="Collapsed">
                        <TextBlock x:Name="DialogErrorText" Text="Սխալ մուտքագրում" FontSize="11" Foreground="{DynamicResource M3ErrorBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Չեղարկել" Style="{StaticResource DialogSecondaryButtonStyle}" HorizontalAlignment="Left" Click="CloseBtn_Click"/>
                <Button Grid.Column="1" Content="Պահպանել փականը" Style="{StaticResource DialogActionButtonStyle}" HorizontalAlignment="Right" Click="SaveLockBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
