<Window x:Class="Panak.Views.BackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panak Backdrop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Grid x:Name="BackdropGrid" ClipToBounds="True" Opacity="0" MouseDown="BackdropGrid_MouseDown">
        <Image x:Name="BlurImage" Stretch="Fill" Margin="-45">
            <Image.Effect>
                <BlurEffect x:Name="BackdropBlurEffect" Radius="28" KernelType="Gaussian" RenderingBias="Performance"/>
            </Image.Effect>
        </Image>
        <Rectangle x:Name="DimOverlay" Fill="#000000" Opacity="0.40"/>
    </Grid>
</Window>
