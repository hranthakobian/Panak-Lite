                                      Fill="{DynamicResource LogoContainerBrush}"/>
                                <!-- 2. Dark brown flower/scallop bottom-left shape -->
                                <Path Data="M23.0319 48.198C24.8429 45.2673 29.1571 45.2673 30.9681 48.198C31.9209 49.7399 33.7031 50.5863 35.5195 50.3597C38.9718 49.9288 41.6617 53.2555 40.4677 56.4791C39.8394 58.1752 40.2795 60.0771 41.5918 61.3364C44.0858 63.7298 43.1258 67.878 39.8258 68.9672C38.0895 69.5402 36.8562 71.0654 36.6761 72.8624C36.3338 76.2778 32.4467 78.1239 29.5259 76.2585C27.989 75.2769 26.011 75.2769 24.4741 76.2585C21.5533 78.1239 17.6662 76.2778 17.3239 72.8624C17.1438 71.0654 15.9105 69.5402 14.1742 68.9672C10.8742 67.878 9.91423 63.7298 12.4082 61.3364C13.7205 60.0771 14.1606 58.1752 13.5323 56.4791C12.3383 53.2555 15.0282 49.9288 18.4805 50.3597C20.2969 50.5863 22.0791 49.7399 23.0319 48.198Z"
                                      Fill="{DynamicResource LogoCloudBrush}"/>
                                <!-- 3. Upper left triangle shape -->
                                <Path Data="M22.303 11.7907C24.3905 8.06977 29.6095 8.06976 31.697 11.7907L42.2653 30.6279C44.3528 34.3488 41.7434 39 37.5683 39H16.4317C12.2566 39 9.64716 34.3488 11.7347 30.6279L22.303 11.7907Z"
                                      Fill="{DynamicResource LogoTriangleBrush}"/>
                                <!-- 4. Lower right shield shape -->
                                <Path Data="M60.69 47.1992C62.9839 45.6003 66.0161 45.6003 68.31 47.1992L78.0961 54.0203C80.5738 55.7472 81.6123 58.9305 80.6373 61.8093L77.0467 72.4109C76.117 75.1559 73.5649 77 70.6955 77H58.3045C55.4351 77 52.883 75.1559 51.9533 72.4109L48.3627 61.8093C47.3877 58.9305 48.4262 55.7472 50.9039 54.0203L60.69 47.1992Z"
                                      Fill="{DynamicResource LogoShieldBrush}"/>
                                <!-- 5. Rotated ellipse shape -->
                                <Path Fill="{DynamicResource LogoEllipseBrush}">
                                    <Path.Data>
                                        <EllipseGeometry Center="63.5067,24.3126" RadiusX="17.9667" RadiusY="10.1973">
                                            <EllipseGeometry.Transform>
                                                <RotateTransform Angle="-49.923" CenterX="63.5067" CenterY="24.3126"/>
                                            </EllipseGeometry.Transform>
                                        </EllipseGeometry>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TitleText" Text="Panak Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Spacer -->

                    <!-- Right: Zoom Controls, Toggle Preview & Close Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Preview Zoom Controls Group (+, Reset, -) -->
                        <Border x:Name="PreviewZoomControlsGroup" Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="12" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviewZoomOutBtn" Style="{StaticResource SecondaryActionButtonStyle}" Width="26" Height="26" Padding="0" Content="−" FontSize="13" FontWeight="Bold" ToolTip="Փոքրացնել (Ctrl + Wheel Down)" Click="PreviewZoomOutBtn_Click"/>
                                <Button x:Name="PreviewZoomResetBtn" Style="{StaticResource SecondaryActionButtonStyle}" Height="26" Padding="6,0" Margin="2,0" ToolTip="Վերականգնել 100% (Կրկնակի կտտոց)" Click="PreviewZoomResetBtn_Click">
                                    <TextBlock x:Name="PreviewZoomValueText" Text="100%" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="PreviewZoomInBtn" Style="{StaticResource SecondaryActionButtonStyle}" Width="26" Height="26" Padding="0" Content="+" FontSize="13" FontWeight="Bold" ToolTip="Մեծացնել (Ctrl + Wheel Up)" Click="PreviewZoomInBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="TogglePreviewBtn" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0" ToolTip="Թաքցնել / Ցուցադրել նախադիտումը" Click="TogglePreviewBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👁️" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TogglePreviewBtnText" Text="Նախադիտում" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeaderCloseBtn" Style="{StaticResource M3IconCloseButtonStyle}" Content="✕" Click="CancelBtn_Click" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

            <!-- Body: 3-Column Responsive Layout (Column 0 = Settings Sections, Column 1 = Resizing Splitter, Column 2 = Live Preview) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="340" MinWidth="240" MaxWidth="460"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Compact Navigation Tabs & Scrollable Settings Sections -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Compact Navigation Tabs above tools -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Settings Sections -->
                    </Grid.RowDefinitions>

                    <!-- Fully Rounded Centered Navigation Tabs (Above tools) -->
                    <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="16" Padding="4,3" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NavTabAppearance" GroupName="NavTabsGroup" Style="{StaticResource NavTabButtonStyle}" Content="🎨 Արտաքին" IsChecked="True" Click="NavTab_Click"/>
                            <RadioButton x:Name="NavTabLayout" Visibility="Collapsed" GroupName="NavTabsGroup" Style="{StaticResource NavTabButtonStyle}" Content="📐 Դիրք" Click="NavTab_Click"/>
                            <RadioButton x:Name="NavTabSecurity" Visibility="Collapsed" GroupName="NavTabsGroup" Style="{StaticResource NavTabButtonStyle}" Content="🔒 Անվտանգություն" Click="NavTab_Click"/>
                            <RadioButton x:Name="NavTabSystem" GroupName="NavTabsGroup" Style="{StaticResource NavTabButtonStyle}" Content="⚙️ Համակարգ" Click="NavTab_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Left Column: Scrollable Settings Sections with Scroll-Spy -->
                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScrollViewer_ScrollChanged">
                        <StackPanel>
                            <!-- Ko-fi Donation Support Card & Contact (AT VERY TOP AS REQUESTED) -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="☕" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SupportTitleText" Text="Աջակցել նախագծին" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SupportDescText" Text="Աջակցեք Panak-ի զարգացմանը Ko-fi-ի միջոցով" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CrowdinButton" Style="{StaticResource SecondaryButtonStyle}" Content="🌐 Crowdin" VerticalAlignment="Center" Padding="14,8" Margin="0,0,8,0" FontWeight="Bold" Click="CrowdinButton_Click" ToolTip="https://crowdin.com/project/panak"/>
                                            <Button x:Name="KofiButton" Style="{StaticResource ActionButtonStyle}" Content="☕ Ko-fi" VerticalAlignment="Center" Padding="18,8" FontWeight="Bold" Click="KofiButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,2,0,8" BorderThickness="0"/>

                                    <!-- Clickable contact links row -->
                                    <WrapPanel Margin="0,2,0,0">
                                        <!-- Crowdin link -->
                                        <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="CrowdinLink_MouseDown" ToolTip="https://crowdin.com/project/panak">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌐 " FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                                <TextBlock Text="Crowdin Translations" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Email link -->
                                        <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="EmailLink_MouseDown" ToolTip="dev@hakobian.am">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✉ " FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                                <TextBlock Text="dev@hakobian.am" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Website link -->
                                        <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="WebsiteLink_MouseDown" ToolTip="https://hakobian.am/contact">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌐 " FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                                <TextBlock Text="hakobian.am" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 1: APPEARANCE (Արտաքին) ================= -->
                            <Border x:Name="SectionAppearance" Margin="0,4,0,6">
                                <TextBlock x:Name="SectionAppearanceTitle" Text="🎨 Արտաքին" Style="{StaticResource SectionDividerHeaderStyle}"/>
                            </Border>

                            <!-- 1. Theme Mode: Light | Dark | Auto (AT VERY TOP AS REQUESTED) -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="ThemeSectionLabel" Text="Theme" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="ThemeSectionDesc" Text="Light, Dark or System Theme" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,10"/>
                                    <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="3" HorizontalAlignment="Stretch">
                                        <Grid x:Name="ThemeSegmentGrid" HorizontalAlignment="Stretch" SizeChanged="ThemeSegmentGrid_SizeChanged">
                                            <!-- Sliding Indicator Pill -->
                                            <Border x:Name="ThemeIndicatorPill"
                                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                    Background="{DynamicResource M3PrimaryBrush}"
                                                    CornerRadius="11">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="ThemePillTranslate" X="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                                                <RadioButton x:Name="SettingsThemeLight" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="☀️ Light" Tag="Light" Click="SettingsTheme_Click"/>
                                                <RadioButton x:Name="SettingsThemeDark" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="🌙 Dark" Tag="Dark" Click="SettingsTheme_Click"/>
                                                <RadioButton x:Name="SettingsThemeAuto" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="⚙️ Auto" Tag="Auto" Click="SettingsTheme_Click"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. Default Folder Color & Real-time Hue Slider -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DefaultColorLabel" Text="Default Folder Color" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                            <TextBlock Text="Material You Real-time Dynamic Palette" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="SettingsColorIndicator" Visibility="Collapsed" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource M3SurfaceContainerBrush}" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="SettingsColorIndicator_MouseDown" ToolTip="Click to add custom swatch"/>
                                    </Grid>

                                    <!-- Preset Pastel Swatches + Inline Custom Swatches (All side-by-side) -->
                                    <WrapPanel x:Name="SettingsColorSwatchesPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                        <WrapPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="RestorePresetsMenuItem" Header="Վերականգնել լռելյայն գույները" Click="RestorePresetsMenuItem_Click"/>
                                            </ContextMenu>
                                        </WrapPanel.ContextMenu>
                                        <WrapPanel x:Name="PresetSwatchesWrapPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <WrapPanel x:Name="CustomSwatchesWrapPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <!-- Pastel Hue Slider: Panel updates in real time (Stretched full width) -->
                                    <Slider x:Name="SettingsHueSlider" Visibility="Collapsed"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,4,0,0"
                                            Minimum="0" Maximum="360"
                                            SmallChange="1" LargeChange="10"
                                            Style="{StaticResource PastelHueSliderStyle}"
                                            ValueChanged="SettingsHueSlider_ValueChanged"/>

                                    <!-- Randomizer Toggle at the bottom with label -->
                                    <StackPanel Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                        <CheckBox x:Name="RandomColorCheckBox" Style="{StaticResource MaterialSwitchStyle}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Random color for new folders" Click="RandomColorCheckBox_Click"/>
                                        <TextBlock x:Name="RandomColorLabel" Text="Պատահականությամբ" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="RandomColorLabel_MouseDown"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3. General Folder Opacity Slider (Disabled in Lite) -->
                            <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="GeneralFolderOpacityLabel" Text="General Folder Opacity" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                            <TextBlock x:Name="GeneralFolderOpacityDescText" Text="Overall background opacity for all folders" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="GeneralFolderOpacityValueText" Grid.Column="1" Text="85%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="GeneralFolderOpacitySlider" Minimum="20" Maximum="100" Value="85" SmallChange="1" LargeChange="5" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GeneralFolderOpacitySlider_ValueChanged"/>

                                    <!-- Randomizer Toggle at the bottom with label -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                        <CheckBox x:Name="RandomOpacityCheckBox" Style="{StaticResource MaterialSwitchStyle}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Random opacity for new folders" Click="RandomOpacityCheckBox_Click"/>
                                        <TextBlock x:Name="RandomOpacityLabel" Text="Պատահականությամբ" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="RandomOpacityLabel_MouseDown"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. Icon Shape -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="IconShapeLabel" Text="Default Icon Shape" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                            <TextBlock Text="Adaptive Icon Shape" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="20" Padding="6,4" VerticalAlignment="Center" BorderThickness="0" SnapsToDevicePixels="True">
                                            <Grid x:Name="SettingsShapeGrid">
                                                <!-- Sliding Shape Pill -->
                                                <Border x:Name="SettingsShapePill" Width="36" Height="36" CornerRadius="11"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{DynamicResource M3PrimaryBrush}">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="SettingsShapePillTranslate" X="2"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <StackPanel x:Name="SettingsShapeSelectorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="SettingsShapeCircle" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                                 Tag="{StaticResource GeomCircle}" ToolTip="Circle" Click="SettingsShape_Click"/>
                                                    <RadioButton x:Name="SettingsShapeSquircle" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                                 Tag="{StaticResource GeomSquircle}" ToolTip="Squircle" Click="SettingsShape_Click"/>
                                                    <RadioButton x:Name="SettingsShapeClover" Visibility="Collapsed" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                                 Tag="{StaticResource GeomStar}" ToolTip="Star" Click="SettingsShape_Click"/>
                                                    <RadioButton x:Name="SettingsShapeScallop" Visibility="Collapsed" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                                 Tag="{StaticResource GeomScallop}" ToolTip="Scallop" Click="SettingsShape_Click"/>
                                                    <RadioButton x:Name="SettingsShapeArch" Visibility="Collapsed" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                                 Tag="{StaticResource GeomArch}" ToolTip="Arch" Click="SettingsShape_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Randomizer Toggle at the bottom with label -->
                                    <StackPanel Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                        <CheckBox x:Name="RandomShapeCheckBox" Style="{StaticResource MaterialSwitchStyle}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Random shape for new folders" Click="RandomShapeCheckBox_Click"/>
                                        <TextBlock x:Name="RandomShapeLabel" Text="Պատահականությամբ" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="RandomShapeLabel_MouseDown"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        <!-- 5. Folder Blur & Radius (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Background="#1FE53935" CornerRadius="6" Padding="6,1.5" Margin="0,0,0,3" HorizontalAlignment="Left">
                                            <TextBlock x:Name="FolderBlurWarningBadge" Text="կարող է դանդաղեցնել համակարգիչը" FontSize="10.5" Foreground="#E53935" FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock x:Name="FolderBlurLabel" Text="Folder Blur Effect" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="FolderBlurDescText" Text="Blur desktop background behind folder cards" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FolderBlurCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                                <StackPanel x:Name="FolderBlurSliderContainer" ClipToBounds="True">
                                    <Grid Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FolderBlurRadiusLabel" Text="Blur Radius" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock x:Name="FolderBlurValueText" Grid.Column="1" Text="28 px" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="FolderBlurSlider" Minimum="2" Maximum="60" Value="28" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FolderBlurSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================= SECTION 2: LAYOUT (Դիրք) ================= -->
                        <Border x:Name="SectionLayout" Visibility="Collapsed" Margin="0,12,0,6">
                            <TextBlock x:Name="SectionLayoutTitle" Text="📐 Դիրք" Style="{StaticResource SectionDividerHeaderStyle}"/>
                        </Border>

                        <!-- 1. Grid Layout & Paging Mode (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Paging Mode -->
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="PagingModeLabel" Text="Page Navigation Mode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="PagingModeDescText" Text="Use paged slider or vertical scrollbar" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Interactive Material 3 Animated Square Cards -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Slider Card -->
                                        <Border x:Name="SliderModeCard" Grid.Column="0" CornerRadius="16" BorderThickness="2"
                                                BorderBrush="{DynamicResource M3PrimaryBrush}" Background="{DynamicResource ShapeCapsuleBgBrush}"
                                                Padding="10,12" Cursor="Hand" MouseLeftButtonDown="SliderModeCard_Click">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard Name="SliderAnimLoaded">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderVectorTransform" Storyboard.TargetProperty="X">
                                                                <LinearDoubleKeyFrame Value="4" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="4" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="-78" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="-78" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderDot1" Storyboard.TargetProperty="Width">
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="3" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="3" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderDot2" Storyboard.TargetProperty="Width">
                                                                <LinearDoubleKeyFrame Value="3" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="3" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderDot2" Storyboard.TargetProperty="(Canvas.Left)">
                                                                <LinearDoubleKeyFrame Value="15" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="15" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="9" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderDot1" Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="0.4" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="0.4" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderDot2" Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame Value="0.4" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="0.4" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:1.3"/>
                                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:1.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <!-- Selection Badge -->
                                                <Border x:Name="SliderCheckBadge" Width="20" Height="20" CornerRadius="10"
                                                        Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Vector Preview ViewBox matching Silder.svg (168x149) -->
                                                    <Viewbox Width="120" Height="86" Stretch="Uniform" HorizontalAlignment="Center">
                                                        <Canvas Width="168" Height="149" ClipToBounds="False">
                                                            <!-- Background Mini Window Card (99x108 at x=34, y=20) -->
                                                            <Border Canvas.Left="34" Canvas.Top="20" Width="99" Height="108" CornerRadius="9"
                                                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1.2">
                                                                <Grid ClipToBounds="True">
                                                                    <!-- Header at (10, 7) -->
                                                                    <Grid Height="14" VerticalAlignment="Top" Margin="10,7,10,0">
                                                                        <Rectangle Width="37" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6" Margin="0,0,3,0"/>
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6" Margin="0,0,3,0"/>
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Grid Viewport (80x74 at x=11, y=23) -->
                                                                    <Border Width="80" Height="74" Margin="11,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                                                        <Canvas ClipToBounds="False">
                                                                            <Canvas.RenderTransform>
                                                                                <TranslateTransform x:Name="SliderVectorTransform" X="4" Y="0"/>
                                                                            </Canvas.RenderTransform>

                                                                            <!-- Page 1 (9 items) -->
                                                                            <Canvas Width="72" Height="72" Canvas.Left="0" Canvas.Top="0">
                                                                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="26.67" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="53.33" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                                <Rectangle Canvas.Left="0" Canvas.Top="26.33" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="26.67" Canvas.Top="26.33" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="53.33" Canvas.Top="26.33" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                                <Rectangle Canvas.Left="0" Canvas.Top="52.67" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="26.67" Canvas.Top="52.67" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="53.33" Canvas.Top="52.67" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            </Canvas>

                                                                            <!-- Page 2 (5 items at x=82) -->
                                                                            <Canvas Width="72" Height="72" Canvas.Left="82" Canvas.Top="0">
                                                                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="26.67" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="53.33" Canvas.Top="0" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                                <Rectangle Canvas.Left="0" Canvas.Top="26.33" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                                <Rectangle Canvas.Left="26.67" Canvas.Top="26.33" Width="18.67" Height="19.33" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            </Canvas>
                                                                        </Canvas>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Pager Controls at (73, 119) matching Silder.svg -->
                                                            <Canvas Canvas.Left="73" Canvas.Top="119" Width="24" Height="7">
                                                                <!-- Left Arrow -->
                                                                <Path Canvas.Left="0" Canvas.Top="1" Data="M2,0 L0,2.5 L2,5" Stroke="{DynamicResource M3OutlineBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <!-- Dot 1 -->
                                                                <Rectangle x:Name="SliderDot1" Canvas.Left="4" Canvas.Top="2" Width="9" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource M3PrimaryBrush}"/>
                                                                <!-- Dot 2 -->
                                                                <Rectangle x:Name="SliderDot2" Canvas.Left="15" Canvas.Top="2" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.4"/>
                                                                <!-- Right Arrow -->
                                                                <Path Canvas.Left="20" Canvas.Top="1" Data="M0,0 L2,2.5 L0,5" Stroke="{DynamicResource M3OutlineBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock x:Name="PagingSliderLabel" Text="Սլայդեր" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Scroll Card -->
                                        <Border x:Name="ScrollModeCard" Grid.Column="2" CornerRadius="16" BorderThickness="1"
                                                BorderBrush="{DynamicResource M3OutlineBrush}" Background="{DynamicResource M3CardBrush}"
                                                Padding="10,12" Cursor="Hand" MouseLeftButtonDown="ScrollModeCard_Click">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard Name="ScrollAnimLoaded">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScrollVectorTransform" Storyboard.TargetProperty="Y">
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="-72" KeyTime="0:0:2.3"/>
                                                                <LinearDoubleKeyFrame Value="-72" KeyTime="0:0:2.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScrollThumbTransform" Storyboard.TargetProperty="Y">
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.0"/>
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="59" KeyTime="0:0:2.3"/>
                                                                <LinearDoubleKeyFrame Value="59" KeyTime="0:0:2.6"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <!-- Selection Badge -->
                                                <Border x:Name="ScrollCheckBadge" Width="20" Height="20" CornerRadius="10" Visibility="Collapsed"
                                                        Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Vector Preview ViewBox matching Scroll.svg (168x149) -->
                                                    <Viewbox Width="120" Height="86" Stretch="Uniform" HorizontalAlignment="Center">
                                                        <Canvas Width="168" Height="149" ClipToBounds="False">
                                                            <!-- Background Mini Window Card (99x108 at x=34, y=20) -->
                                                            <Border Canvas.Left="34" Canvas.Top="20" Width="99" Height="108" CornerRadius="9"
                                                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1.2">
                                                                <Grid ClipToBounds="True">
                                                                    <!-- Header at (10, 7) -->
                                                                    <Grid Height="14" VerticalAlignment="Top" Margin="10,7,10,0">
                                                                        <Rectangle Width="37" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6" Margin="0,0,3,0"/>
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6" Margin="0,0,3,0"/>
                                                                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource M3OutlineBrush}" Opacity="0.6"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Grid Viewport (72x71 at x=10, y=23) -->
                                                                    <Border Width="72" Height="71" Margin="10,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                                                        <Canvas ClipToBounds="False">
                                                                            <Canvas.RenderTransform>
                                                                                <TranslateTransform x:Name="ScrollVectorTransform" X="0" Y="0"/>
                                                                            </Canvas.RenderTransform>

                                                                            <!-- 14 Items (3 columns, 5 rows, last row 2 items) -->
                                                                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="27" Canvas.Top="0" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="54" Canvas.Top="0" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                            <Rectangle Canvas.Left="0" Canvas.Top="24" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="27" Canvas.Top="24" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="54" Canvas.Top="24" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                            <Rectangle Canvas.Left="0" Canvas.Top="48" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="27" Canvas.Top="48" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="54" Canvas.Top="48" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                            <Rectangle Canvas.Left="0" Canvas.Top="72" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="27" Canvas.Top="72" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="54" Canvas.Top="72" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>

                                                                            <Rectangle Canvas.Left="0" Canvas.Top="96" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                            <Rectangle Canvas.Left="27" Canvas.Top="96" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{DynamicResource M3PrimaryBrush}" Opacity="0.5"/>
                                                                        </Canvas>
                                                                    </Border>

                                                                    <!-- Scrollbar Track & Thumb at (88, 20) in Card -->
                                                                    <Rectangle Canvas.Left="88" Canvas.Top="20" Width="4" Height="81.5" RadiusX="2" RadiusY="2" Fill="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Left" Margin="88,20,0,0"/>
                                                                    <Rectangle Canvas.Left="88" Canvas.Top="20" Width="4" Height="22.5" RadiusX="2" RadiusY="2" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Left" Margin="88,20,0,0">
                                                                        <Rectangle.RenderTransform>
                                                                            <TranslateTransform x:Name="ScrollThumbTransform" X="0" Y="0"/>
                                                                        </Rectangle.RenderTransform>
                                                                    </Rectangle>
                                                                </Grid>
                                                            </Border>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock x:Name="PagingScrollbarLabel" Text="Ուղղահայաց" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Columns Slider -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GridColumnsLabel" Text="Items per row" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="GridColumnsValueText" Grid.Column="1" Text="5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="GridColumnsSlider" Minimum="3" Maximum="8" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GridColumnsSlider_ValueChanged"/>

                                <!-- Rows Slider (for Slider mode) -->
                                <StackPanel x:Name="GridRowsContainer" Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GridRowsLabel" Text="Rows per page" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="GridRowsValueText" Grid.Column="1" Text="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="GridRowsSlider" Minimum="1" Maximum="5" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GridRowsSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Slider Navigation Options -->
                                <StackPanel x:Name="SliderInteractionsContainer" Margin="0,10,0,0">
                                    <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,0,0,10" BorderThickness="0"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SliderArrowsLabel" Text="Show arrow navigation buttons" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="SliderArrowsCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SliderDragLabel" Text="Mouse drag swipe on pages" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="SliderDragCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Focus Mode & Dimming (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="FocusModeLabel" Text="Focus Mode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="FocusModeDescText" Text="Dims background on popup open" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FocusModeCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                                <StackPanel x:Name="FocusDimmingContainer" ClipToBounds="True">
                                    <Grid Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FocusDimmingLabel" Text="Focus Dimming Opacity" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock x:Name="FocusDimmingValueText" Grid.Column="1" Text="45%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="FocusDimmingSlider" Minimum="0" Maximum="80" Value="45" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FocusDimmingSlider_ValueChanged"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,10,0,10" BorderThickness="0"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Background="#1FE53935" CornerRadius="6" Padding="6,1.5" Margin="0,0,0,3" HorizontalAlignment="Left">
                                            <TextBlock x:Name="FocusBlurWarningBadge" Text="կարող է դանդաղեցնել համակարգիչը" FontSize="10.5" Foreground="#E53935" FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock x:Name="FocusBlurLabel" Text="Background Blur Effect" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="FocusBlurDescText" Text="Blur desktop background behind popup" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FocusBlurCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                                <StackPanel x:Name="FocusBlurSliderContainer" ClipToBounds="True">
                                    <Grid Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FocusBlurRadiusLabel" Text="Blur Radius" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock x:Name="FocusBlurValueText" Grid.Column="1" Text="28 px" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="FocusBlurSlider" Minimum="2" Maximum="60" Value="28" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FocusBlurSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Center Screen Popup Only -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CenterPopupLabel" Text="Center Screen Popup" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="CenterPopupDescText" Text="Open folder popups in the center of the screen only" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CenterPopupCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ================= SECTION 3: SECURITY (Անվտանգություն) ================= -->
                        <Border x:Name="SectionSecurity" Visibility="Collapsed" Margin="0,12,0,6">
                            <TextBlock x:Name="SectionSecurityTitle" Text="🔒 Անվտանգություն" Style="{StaticResource SectionDividerHeaderStyle}"/>
                        </Border>

                        <!-- 1. "Անջատել նիշքի քաշելով հանելը" (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LockFoldersLabel" Text="Անջատել նիշքի քաշելով հանելը" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="LockFoldersDescText" Text="Արգելել նիշքերը քաշելով պանակից դուրս հանելը (Drag &amp; Drop)" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="LockFoldersCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2. "Արգելափակել փոփափի տեղաշարժումը" (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LockPopupPositionLabel" Text="Արգելափակել փոփափի տեղաշարժումը" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="LockPopupPositionDescText" Text="Արգելել պանակի փոփափի տեղաշարժումը մկնիկով" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="LockPopupPositionCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2. "Կողպել Կայանքները" Card (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LockSettingsLabel" Text="Կողպել Կայանքները" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="LockSettingsDescText" Text="Պահանջել գաղտնաբառ/PIN/նախշ/կենսաչափություն կայանքները բացելու կամ փոփոխելու համար" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="LockSettingsCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" Click="LockSettingsCheckBox_Click"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,4,0,8" BorderThickness="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SettingsLockStatusText" Text="Կայանքները պաշտպանված չեն" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="ConfigureSettingsLockBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Կարգավորել կողպումը" Padding="12,5" FontSize="11" Click="ConfigureSettingsLockBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>


                        <!-- ================= SECTION 4: SYSTEM (Համակարգ) ================= -->
                        <Border x:Name="SectionSystem" Margin="0,12,0,6">
                            <TextBlock x:Name="SectionSystemTitle" Text="⚙️ Համակարգ" Style="{StaticResource SectionDividerHeaderStyle}"/>
                        </Border>

                        <!-- 1. Language Selection with AI Notice & Crowdin OTA -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="LanguageLabel" Text="Language" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                            <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LanguageAiBadge" Text="Թարգմանված է ԱԲ-ով" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="LanguageComboBox" Width="140" Style="{StaticResource MaterialComboBoxStyle}" SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Հայերեն" Tag="hy"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Русский" Tag="ru"/>
                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                            <ComboBoxItem Content="Español" Tag="es"/>
                                            <ComboBoxItem Content="中文" Tag="zh"/>
                                            <ComboBoxItem Content="العربية" Tag="ar"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,8,0,8" BorderThickness="0"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="CrowdinOtaStatusText" Text="OTA համակարգը պատրաստ է" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CheckOtaBtn" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 Ստուգել OTA" Padding="12,6" Margin="0,0,6,0" FontSize="11" Click="CheckOtaBtn_Click"/>
                                        <Button x:Name="OpenCrowdinBtn" Style="{StaticResource SecondaryButtonStyle}" Content="🌐 Crowdin" Padding="12,6" Margin="0,0,6,0" FontSize="11" Click="CrowdinButton_Click"/>
                                        <Button x:Name="ExportLangJsonBtn" Style="{StaticResource SecondaryButtonStyle}" Content="💾 Արտահանել JSON" Padding="12,6" FontSize="11" Click="ExportLangJsonBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Right Double-Click & Space Quick Look -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Visibility="Collapsed">
                                    <TextBlock x:Name="RightDoubleClickLabel" Text="Right Double-Click Open"/>
                                    <TextBlock x:Name="RightDoubleClickDescText" Text="Open any Windows folder with right double-click"/>
                                    <CheckBox x:Name="RightDoubleClickCheckBox" IsChecked="False"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SpaceQuickLookLabel" Text="Արագ դիտում" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="SpaceQuickLookDescText" Text="Press Space in Explorer to quickly view folder" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SpaceQuickLookCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Key Shortcuts & Rebinding (Ստեղների վերագրանցում) -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="KeyRebindingLabel" Text="Ստեղների վերագրանցում" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="KeyRebindingDescText" Text="Կարգավորեք ստեղնաշարի հիմնական դյուրանցումները" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="ResetKeysBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Վերականգնել" Padding="12,5" FontSize="11" VerticalAlignment="Center" Click="ResetKeysBtn_Click"/>
                                </Grid>

                                <!-- Quick Look Hotkey Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="QuickLookKeyRowLabel" Text="Արագ դիտում" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="QuickLookKeyRowDesc" Text="Explorer-ում ընտրված պանակի արագ բացում" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="QuickLookKeysContainer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,2,0,10" BorderThickness="0"/>

                                <!-- Close Popup Hotkey Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ClosePopupKeyRowLabel" Text="Փակել փոփափը" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="ClosePopupKeyRowDesc" Text="Բացված պանակի փոփափը փակելու ստեղն" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ClosePopupKeysContainer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Combine Files On Drop (Disabled in Lite) -->
                        <Border Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CombineFilesLabel" Text="Combine Files on Drop" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="CombineFilesDescText" Text="Drop a file onto another file to combine into a Panak folder" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CombineFilesCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="False"/>
                            </Grid>
                        </Border>

                        <!-- 5. Auto-start & Shell Context Menu Integration -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AutoStartLabel" Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,4,0,8" BorderThickness="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ContextMenuStatusText" Text="Explorer context menu active" FontSize="12" Foreground="{DynamicResource M3PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="ReRegisterContextBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Re-register" Padding="12,5" FontSize="11" Click="ReRegisterContextBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. GitHub Real-time Updates -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdatesSectionTitle" Text="Updates" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="UpdatesSectionDesc" Text="Real-time updates via GitHub Releases" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CheckUpdatesBtn" Style="{StaticResource SecondaryButtonStyle}" Content="Check for updates" Padding="14,6" FontSize="12" Click="CheckUpdatesBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Version & Status Row -->
                                <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateStatusTitleText" Text="Current version: v1.0.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                            <TextBlock x:Name="UpdateStatusDetailText" Text="You are using the latest version" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatusBadge" Grid.Column="1" Text="✓ Latest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Update Available Card (Visible when update found) -->
                                <Border x:Name="UpdateAvailableCard" Background="{DynamicResource M3CardBrush}" BorderBrush="{DynamicResource M3PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NewVersionAvailableText" Text="New version available: v1.1.0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                            <TextBlock x:Name="NewVersionDateText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="ReleaseNotesHeader" Text="Release Notes:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                            <TextBlock x:Name="ReleaseNotesContentText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        </ScrollViewer>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:WavyProgressBar x:Name="UpdateProgressBar" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                            <Button x:Name="DownloadInstallBtn" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="Download &amp; Install" Padding="16,6" FontSize="12" Click="DownloadInstallBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto Check Toggle -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AutoCheckUpdatesLabel" Text="Check for updates automatically" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="AutoCheckUpdatesDesc" Text="Periodically check GitHub in the background" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 7. Backup & Restore Configuration: Export & Import -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExportImportSectionTitle" Text="Կարգավորումների պահուստավորում" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="ExportImportSectionDesc" Text="Արտահանեք կամ ներմուծեք JSON ֆայլով" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ExportSettingsBtn" Style="{StaticResource SecondaryButtonStyle}" Content="Արտահանել" Padding="14,6" Margin="0,0,8,0" Click="ExportSettingsBtn_Click"/>
                                    <Button x:Name="ImportSettingsBtn" Style="{StaticResource SecondaryButtonStyle}" Content="Ներմուծել" Padding="14,6" Click="ImportSettingsBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 8. Installer & Uninstaller Tools -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallerSectionTitle" Text="Ապատեղադրիչ" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="UninstallAppBtn" Style="{StaticResource DangerButtonStyle}" Content="Uninstall" Padding="14,6" Click="UninstallAppBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

                <!-- Center Vertical Resizing Splitter Line (Smooth hover fade-in, dark color) -->
                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" Focusable="False" Cursor="SizeWE" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border x:Name="SplitterLine" Width="3" CornerRadius="1.5" Background="#1C1C26" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,16" Opacity="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SplitterLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SplitterLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="SplitterLine" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Right Column: Live Desktop Preview Pane -->
                <Border x:Name="PreviewCardBorder" Grid.Column="2" Margin="4,0,0,0" CornerRadius="18" Background="#181824" BorderThickness="0" ClipToBounds="True" SizeChanged="PreviewCardBorder_SizeChanged" PreviewMouseWheel="PreviewDesktop_PreviewMouseWheel">
                    <Border.Clip>
                        <RectangleGeometry x:Name="PreviewClipRect" RadiusX="18" RadiusY="18"/>
                    </Border.Clip>
                    <Grid>
                        <!-- Wallpaper image background -->
                        <Image x:Name="PreviewWallpaperImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                            <Image.Effect>
                                <BlurEffect x:Name="PreviewFocusWallpaperBlurFx" Radius="0" RenderingBias="Performance"/>
                            </Image.Effect>
                        </Image>

                        <!-- Focus Mode Dimming Backdrop for Settings Preview -->
                        <Border x:Name="PreviewFocusDimOverlay" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

                        <!-- Top live preview badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Background="#9A000000" CornerRadius="8" Padding="9,3.5" MouseDown="LivePreviewBadge_MouseDown" Cursor="Hand" ToolTip="Ctrl + Wheel: Zoom / Կրկնակի կտտոց: Վերականգնել 100%">
                            <TextBlock x:Name="PreviewLiveBadgeText" Text="Live Preview" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <!-- Desktop Workspace Canvas with ScaleTransform -->
                        <Canvas x:Name="PreviewDesktopCanvas" ClipToBounds="False" Background="Transparent" MouseLeftButtonDown="PreviewDesktopCanvas_MouseLeftButtonDown">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="PreviewDesktopScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                            </Canvas.RenderTransform>

                            <!-- Desktop folder icon at bottom left -->
                            <StackPanel x:Name="PreviewDesktopIcon" Cursor="Hand" Width="52"
                                        PreviewMouseLeftButtonDown="PreviewDesktopIcon_MouseLeftButtonDown"
                                        PreviewMouseMove="PreviewDesktopIcon_MouseMove"
                                        PreviewMouseLeftButtonUp="PreviewDesktopIcon_MouseLeftButtonUp"
                                        ToolTip="Բացել Panak-ը">
                                <Grid Width="46" Height="46" HorizontalAlignment="Center">
                                    <Path x:Name="PreviewDesktopIconShapePath" Data="{StaticResource GeomSquircle}" Stretch="Uniform" Width="46" Height="46" Fill="{DynamicResource M3SurfaceContainerBrush}"/>
                                    <UniformGrid x:Name="PreviewDesktopIconMiniGrid" Columns="2" Rows="2" Margin="7"/>
                                </Grid>
                                <TextBlock x:Name="PreviewDesktopIconLabel" Text="Panak" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Floating Folder Popup Preview Card (Anchored above desktop icon) -->
                            <Grid x:Name="PreviewPopupContainer" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" RenderTransformOrigin="0.0,1.0">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PreviewPopupScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="PreviewPopupTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Outer Card Surface with 28px rounded corners & Acrylic Frosted Glass -->
                            <Border x:Name="PreviewCardBorderInner" CornerRadius="28" Background="#01000000" BorderThickness="1" BorderBrush="#38FFFFFF">
                                <Border x:Name="PreviewInnerClippingBorder" CornerRadius="28">
                                    <Border.Clip>
                                        <RectangleGeometry x:Name="PreviewCardClipGeometry" RadiusX="28" RadiusY="28"/>
                                    </Border.Clip>
                                    <Grid>
                                        <!-- Blurred Screen Wallpaper layer -->
                                        <Image x:Name="PreviewPopupBlurImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="LowQuality">
                                            <Image.Effect>
                                                <BlurEffect x:Name="PreviewPopupBlurEffect" Radius="28" KernelType="Gaussian" RenderingBias="Performance"/>
                                            </Image.Effect>
                                        </Image>

                                        <!-- Frosted Glass Dark/Light Tint Overlay -->
                                        <Border x:Name="PreviewFrostedTintLayer" CornerRadius="28" Background="#C216161D"/>

                                        <!-- Background Accent Tint Layer -->
                                        <Border x:Name="PreviewTintLayer" CornerRadius="28" Background="#180078D4" Opacity="1.0"/>

                                        <!-- Content Layout with exact padding 12,12,12,10 -->
                                        <Grid x:Name="PreviewMainContentGrid" Margin="12,12,12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Header -->
                                                <RowDefinition Height="Auto"/> <!-- Edit Flyout (collapsible) -->
                                                <RowDefinition Height="*"/>    <!-- Items Grid (Slider or Scroll) -->
                                                <RowDefinition Height="Auto"/> <!-- Pager Footer (Slider mode) -->
                                            </Grid.RowDefinitions>

                                            <!-- Header Row -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Title and Count Badge -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PreviewFolderTitleText" Text="Panak" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PopupTextBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="PreviewItemCountBorder" Background="{DynamicResource PopupItemBadgeBg}" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="PreviewItemCountBadge" Text="13 նիշք" FontSize="10" Foreground="{DynamicResource PopupItemBadgeFg}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Header Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Pin Button -->
                                                    <Button x:Name="PreviewPinButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" ToolTip="Ամրացնել" Click="PreviewPinButton_Click" RenderTransformOrigin="0.5,0.5">
                                                        <Button.RenderTransform>
                                                            <ScaleTransform x:Name="PreviewPinButtonScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Button.RenderTransform>
                                                        <Path x:Name="PreviewPinIconPath" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}"
                                                              Data="M16,12V4H17V2H7V4H8V12L5,15V17H11V22L12,23L13,22V17H19V15L16,12Z"/>
                                                    </Button>

                                                    <!-- Edit Button -->
                                                    <Button x:Name="PreviewEditButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" ToolTip="Խմբագրել պանակը" Click="PreviewEditButton_Click">
                                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}"
                                                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                    </Button>

                                                    <!-- Explorer Button -->
                                                    <Button x:Name="PreviewExplorerButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" ToolTip="Բացել Explorer-ում" Click="PreviewExplorerButton_Click">
                                                        <Path Width="12" Height="10" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}"
                                                              Data="M19,18H5V8H19M20,6H12L10,4H4C2.9,4 2,4.9 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6Z"/>
                                                    </Button>

                                                    <!-- Overflow 3-dots Button -->
                                                    <Button x:Name="PreviewMoreButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Այլ գործողություններ" Click="PreviewMoreButton_Click">
                                                        <TextBlock Text="•••" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                    </Button>

                                                    <!-- Close Button -->
                                                    <Button x:Name="PreviewCloseButton" Style="{StaticResource HeaderButtonStyle}" ToolTip="Փակել" Click="PreviewCloseButton_Click">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Edit Panel Flyout (Collapsible with smooth animation) -->
                                            <Grid x:Name="PreviewEditPanelContainer" Grid.Row="1" ClipToBounds="True" Visibility="Collapsed" Height="0">
                                                <Border x:Name="PreviewEditPanel" Width="234" HorizontalAlignment="Center" Background="#20FFFFFF" CornerRadius="12" Padding="10" Margin="0,0,0,10" Opacity="0" RenderTransformOrigin="0.5,0">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="PreviewEditPanelTranslate" Y="-10"/>
                                                    </Border.RenderTransform>
                                                    <StackPanel>
                                                        <!-- Always Open with Panak -->
                                                        <CheckBox x:Name="PreviewAlwaysPanakCheckBox" Style="{StaticResource M3ExpressiveToggleSwitchStyle}" Content="Միշտ բացել որպես Panak" Margin="0,0,0,12" IsChecked="True" Checked="PreviewAlwaysPanakCheckBox_Checked" Unchecked="PreviewAlwaysPanakCheckBox_Unchecked"/>

                                                        <!-- Name editor -->
                                                        <TextBlock x:Name="PreviewEditNameLabel" Text="Անուն" FontSize="11" Foreground="{DynamicResource PopupSubtextBrush}" Margin="0,0,0,4"/>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="PreviewNameEditBox" Style="{StaticResource M3ExpressiveTextBoxStyle}" Text="Panak" KeyDown="PreviewNameEditBox_KeyDown"/>
                                                            <Button Grid.Column="1" Content="✓" Style="{StaticResource M3ExpressiveFilledIconButton}" Margin="6,0,0,0" ToolTip="Պահպանել" Click="PreviewSaveNameButton_Click"/>
                                                        </Grid>

                                                        <!-- Color & Shape Combined Section -->
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock x:Name="PreviewColorThemeLabel" Text="Գույն և ձև" FontSize="11" Foreground="{DynamicResource PopupSubtextBrush}" Margin="0,0,0,6"/>

                                                            <!-- Pastel Preset Swatches (8 colors) -->
                                                            <UniformGrid x:Name="PreviewColorSwatchesPanel" Columns="8" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                                <RadioButton x:Name="PreviewAccentSwatch" GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#FCDDC5" Tag="#FCDDC5" ToolTip="Դեղձենի / Հիմնական" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#C5FCC5" Tag="#C5FCC5" ToolTip="Անանուխ" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#C5FCFC" Tag="#C5FCFC" ToolTip="Փիրուզ" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#C5DDFC" Tag="#C5DDFC" ToolTip="Երկնագույն" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#DDC5FC" Tag="#DDC5FC" ToolTip="Նարդոս" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#FCC5FC" Tag="#FCC5FC" ToolTip="Եղրևանի" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#FCC5DD" Tag="#FCC5DD" ToolTip="Վարդագույն" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                                <RadioButton GroupName="PreviewFolderColorGroup" Style="{StaticResource PopupColorSwatchStyle}" Background="#FCFCC5" Tag="#FCFCC5" ToolTip="Կարագագույն" Checked="PreviewColorSwatch_Checked" Click="PreviewColorSwatch_Checked"/>
                                                            </UniformGrid>

                                                            <!-- Pastel Hue Slider -->
                                                            <Slider x:Name="PreviewHueSlider" Visibility="Collapsed"
                                                                    HorizontalAlignment="Stretch"
                                                                    Margin="0,0,0,6"
                                                                    Minimum="0" Maximum="360"
                                                                    SmallChange="1" LargeChange="10"
                                                                    Style="{StaticResource PastelHueSliderStyle}"
                                                                    ValueChanged="PreviewHueSlider_ValueChanged"/>

                                                            <!-- Opacity Slider -->
                                                            <Slider x:Name="PreviewOpacitySlider" Visibility="Collapsed"
                                                                    HorizontalAlignment="Stretch"
                                                                    Margin="0,0,0,10"
                                                                    Minimum="0.20" Maximum="1.0"
                                                                    SmallChange="0.05" LargeChange="0.1"
                                                                    Style="{StaticResource OpacitySliderStyle}"
                                                                    ValueChanged="PreviewOpacitySlider_ValueChanged"/>

                                                            <!-- Shape Selector: Justified 5-Shape Capsule Bar -->
                                                            <Border x:Name="PreviewShapeCapsuleBorder" Background="{DynamicResource ShapeCapsuleBgBrush}" CornerRadius="21" Padding="4,3" HorizontalAlignment="Stretch" SnapsToDevicePixels="True">
                                                                <Grid x:Name="PreviewShapeCapsuleGrid" HorizontalAlignment="Stretch" SizeChanged="PreviewShapeCapsuleGrid_SizeChanged">
                                                                    <!-- Sliding Preview Shape Pill -->
                                                                    <Border x:Name="PreviewShapePill" Height="36" CornerRadius="11"
                                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                            Background="{DynamicResource ShapeSelectedBgBrush}">
                                                                        <Border.RenderTransform>
                                                                            <TranslateTransform x:Name="PreviewShapePillTranslate" X="0"/>
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                    <UniformGrid x:Name="PreviewShapeSelectorPanel" Columns="5" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                        <RadioButton x:Name="PreviewShapeRadioCircle" GroupName="PreviewFolderShapeGroup" Style="{StaticResource PopupShapeSelectorRadioStyle}"
                                                                                     Tag="{StaticResource GeomCircle}" ToolTip="Շրջան" Click="PreviewShapeRadio_Click"/>
                                                                        <RadioButton x:Name="PreviewShapeRadioSquircle" GroupName="PreviewFolderShapeGroup" Style="{StaticResource PopupShapeSelectorRadioStyle}"
                                                                                     Tag="{StaticResource GeomSquircle}" ToolTip="Շրջանակված քառակուսի" Click="PreviewShapeRadio_Click"/>
                                                                        <RadioButton x:Name="PreviewShapeRadioClover" Visibility="Collapsed" GroupName="PreviewFolderShapeGroup" Style="{StaticResource PopupShapeSelectorRadioStyle}"
                                                                                     Tag="{StaticResource GeomStar}" ToolTip="Քառաթեւ աստղ" Click="PreviewShapeRadio_Click"/>
                                                                        <RadioButton x:Name="PreviewShapeRadioScallop" Visibility="Collapsed" GroupName="PreviewFolderShapeGroup" Style="{StaticResource PopupShapeSelectorRadioStyle}"
                                                                                     Tag="{StaticResource GeomScallop}" ToolTip="Ծաղիկ" Click="PreviewShapeRadio_Click"/>
                                                                        <RadioButton x:Name="PreviewShapeRadioArch" Visibility="Collapsed" GroupName="PreviewFolderShapeGroup" Style="{StaticResource PopupShapeSelectorRadioStyle}"
                                                                                     Tag="{StaticResource GeomArch}" ToolTip="Կամար" Click="PreviewShapeRadio_Click"/>
                                                                    </UniformGrid>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Unpack button -->
                                                            <Button x:Name="PreviewUnpackFolderButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,10,0,0" Padding="8,6" HorizontalAlignment="Stretch" ToolTip="Հանել բոլոր նիշքերը պանակից" Click="PreviewUnpackFolderButton_Click">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <TextBlock Text="📦 " FontSize="12"/>
                                                                    <TextBlock x:Name="PreviewUnpackFolderBtnText" Text="Ապահավաքել Panak-ը" FontSize="11" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Folder Lock Config Section -->
                                                            <Border Height="1" Background="#25FFFFFF" Margin="0,10,0,8"/>
                                                            <TextBlock x:Name="PreviewFolderLockHeaderLabel" Visibility="Collapsed" Text="Կողպել պանակը" FontSize="11" Foreground="{DynamicResource PopupSubtextBrush}" Margin="0,0,0,4"/>
                                                            <Button x:Name="PreviewFolderLockBtn" Visibility="Collapsed" Style="{StaticResource HeaderButtonStyle}" Padding="8,6" HorizontalAlignment="Stretch" Click="PreviewFolderLockBtn_Click">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <TextBlock Text="🔒 " FontSize="12"/>
                                                                    <TextBlock x:Name="PreviewFolderLockBtnText" Text="Կարգավորել կողպումը" FontSize="11" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Items Content Area -->
                                            <Grid x:Name="PreviewContentAreaGrid" Grid.Row="2" ClipToBounds="True">
                                                <!-- Slider Pages Viewport (Slider Mode) -->
                                                <Grid x:Name="PreviewSliderPagesViewport" ClipToBounds="True" Visibility="Visible"
                                                      PreviewMouseDown="PreviewSlider_MouseDown"
                                                      PreviewMouseMove="PreviewSlider_MouseMove"
                                                      PreviewMouseUp="PreviewSlider_MouseUp"
                                                      PreviewMouseWheel="PreviewSlider_MouseWheel">
                                                    <Canvas ClipToBounds="False">
                                                        <StackPanel x:Name="PreviewSliderPagesPanel" Orientation="Horizontal">
                                                            <StackPanel.RenderTransform>
                                                                <TranslateTransform x:Name="PreviewPagesTranslateX" X="0"/>
                                                            </StackPanel.RenderTransform>
                                                        </StackPanel>
                                                    </Canvas>
                                                </Grid>

                                                <!-- ScrollViewer (ScrollBar Mode) -->
                                                <ScrollViewer x:Name="PreviewItemsScrollViewer" Visibility="Collapsed"
                                                              Style="{StaticResource PanakScrollViewerStyle}"
                                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                              PreviewMouseWheel="PreviewScrollViewer_MouseWheel"
                                                              MaxHeight="380">
                                                    <UniformGrid x:Name="PreviewScrollGrid" HorizontalAlignment="Center"/>
                                                </ScrollViewer>
                                            </Grid>

                                            <!-- Footer Pager Row (Slider Mode) -->
                                            <Grid x:Name="PreviewFooterPagerGrid" Grid.Row="3" Margin="0,6,0,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button x:Name="PreviewSliderPrevBtn" Style="{StaticResource HeaderButtonStyle}" Width="24" Height="22" Padding="0" Margin="0,0,6,0" ToolTip="Previous page" Click="PreviewSliderPrevBtn_Click">
                                                        <TextBlock Text="‹" FontSize="16" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                    </Button>
                                                    <StackPanel x:Name="PreviewSliderDotsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                    <Button x:Name="PreviewSliderNextBtn" Style="{StaticResource HeaderButtonStyle}" Width="24" Height="22" Padding="0" Margin="6,0,0,0" ToolTip="Next page" Click="PreviewSliderNextBtn_Click">
                                                        <TextBlock Text="›" FontSize="16" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- In-Preview Overflow Dropdown Menu -->
                                        <Border x:Name="PreviewMoreActionsMenuBorder"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0, 42, 10, 0"
                                                CornerRadius="14"
                                                Padding="5"
                                                Visibility="Collapsed"
                                                Opacity="0"
                                                Panel.ZIndex="1000"
                                                BorderThickness="0"
                                                MinWidth="144"
                                                RenderTransformOrigin="0.9, 0.0">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="PreviewMoreActionsMenuScale" ScaleX="0.85" ScaleY="0.85"/>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.36" Color="#000000" Direction="270"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <!-- Pin Item -->
                                                <Border Style="{StaticResource PreviewDropdownItemStyle}" MouseLeftButtonDown="PreviewMenuPin_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="PreviewMenuPinIconPath" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}" Data="M16,12V4H17V2H7V4H8V12L5,15V17H11V22L12,23L13,22V17H19V15L16,12Z" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PreviewMenuPinText" Grid.Column="1" Text="Ամրացնել" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PopupTextBrush}" VerticalAlignment="Center" Margin="6,0,10,0" TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Edit Item -->
                                                <Border Style="{StaticResource PreviewDropdownItemStyle}" MouseLeftButtonDown="PreviewMenuEdit_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="PreviewMenuEditIconPath" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PreviewMenuEditText" Grid.Column="1" Text="Խմբագրել" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PopupTextBrush}" VerticalAlignment="Center" Margin="6,0,10,0" TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Explorer Item -->
                                                <Border Style="{StaticResource PreviewDropdownItemStyle}" MouseLeftButtonDown="PreviewMenuExplorer_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="PreviewMenuExplorerIconPath" Width="12" Height="10" Stretch="Uniform" Fill="{DynamicResource PopupHeaderBtnFg}" Data="M19,18H5V8H19M20,6H12L10,4H4C2.9,4 2,4.9 2,6V18A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6Z" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PreviewMenuExplorerText" Grid.Column="1" Text="Explorer-ում" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PopupTextBrush}" VerticalAlignment="Center" Margin="6,0,10,0" TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Panak Lite v1.0.0" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" x:FieldModifier="public" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0" Click="CancelBtn_Click"/>
                    <Button x:Name="ApplyBtn" x:FieldModifier="public" Style="{StaticResource SecondaryButtonStyle}" Content="Apply" Margin="0,0,10,0" Click="ApplyBtn_Click"/>
                    <Button x:Name="SaveBtn" x:FieldModifier="public" Style="{StaticResource ActionButtonStyle}" Content="Save" Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings Lock Dark Backdrop Overlay -->
        <Border x:Name="SettingsLockBackdrop" CornerRadius="24" Background="#85000000" Visibility="Collapsed" Opacity="0"/>

        <!-- Settings Lock Modal Card Container (Fixed-size, centered, smooth scale-up & fade-out) -->
        <Grid x:Name="SettingsLockCardContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SettingsLockScale" ScaleX="1.0" ScaleY="1.0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Border Background="{DynamicResource M3SurfaceBrush}" CornerRadius="24" Padding="16" BorderBrush="{DynamicResource M3SurfaceContainerBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <controls:LockOverlayControl x:Name="SettingsLockOverlay"/>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
