        <!-- Material 3 Shape Selector Radio Style: Bare silhouette on capsule pill track -->
        <Style x:Key="ShapeSelectorRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="Transparent" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Shape silhouette path -->
                            <Path x:Name="ShapePath" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stretch="Uniform" Width="18" Height="18"
                                  Fill="{DynamicResource M3PrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ShapePath" Property="Fill" Value="{DynamicResource M3OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Settings Theme Segment Radio Style -->
        <Style x:Key="SettingsThemeSegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" CornerRadius="11" Background="Transparent" Padding="6,4">
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.FontWeight="Medium"
                                              TextElement.Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
                                <Setter TargetName="Presenter" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Radio Style: Borderless with Material scaling & elevation -->
        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="SwatchRoot">
                            <!-- Material selected ring indicator -->
                            <Ellipse x:Name="SelectionRing" Width="26" Height="26" Fill="{DynamicResource M3PrimaryBrush}" Visibility="Collapsed" Opacity="0.35"/>
                            <Ellipse x:Name="InnerColor" Width="20" Height="20" Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="InnerColor" Property="Width" Value="22"/>
                                <Setter TargetName="InnerColor" Property="Height" Value="22"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchRoot" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 Expressive Radio Button Style -->
        <Style x:Key="M3ExpressiveRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" VerticalAlignment="Center" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Outer Ring -->
                            <Border x:Name="OuterRing" Width="20" Height="20" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{DynamicResource M3OutlineBrush}" Background="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Inner Bloom Dot -->
                                <Border x:Name="InnerDot" Width="0" Height="0" CornerRadius="5"
                                        Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0"/>
                            </Border>
                            <!-- Content -->
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width" To="10" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height" To="10" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 Hue Slider Styles: Pure borderless rainbow track -->
        <Style x:Key="PastelHueThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid x:Name="HueThumbRoot" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#FFFFFF"/>
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource SettingsHueThumbBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PastelHueSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="28">
                            <Border Height="14" CornerRadius="7" BorderThickness="0" Margin="4,0,4,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FCC5C5" Offset="0.0"/>
                                        <GradientStop Color="#FCDDC5" Offset="0.073"/>
                                        <GradientStop Color="#FCFCC5" Offset="0.166"/>
                                        <GradientStop Color="#DFFCC5" Offset="0.25"/>
                                        <GradientStop Color="#C5FCC5" Offset="0.333"/>
                                        <GradientStop Color="#C5FCDD" Offset="0.416"/>
                                        <GradientStop Color="#C5FCFC" Offset="0.5"/>
                                        <GradientStop Color="#C5DDFC" Offset="0.583"/>
                                        <GradientStop Color="#C5C5FC" Offset="0.666"/>
                                        <GradientStop Color="#DDC5FC" Offset="0.75"/>
                                        <GradientStop Color="#FCC5FC" Offset="0.833"/>
                                        <GradientStop Color="#FCC5DD" Offset="0.916"/>
                                        <GradientStop Color="#FCC5C5" Offset="1.0"/>
