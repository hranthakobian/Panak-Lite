    <!-- Main Window Surface: Pure borderless Material You card -->
    <Border x:Name="MainWindowBorder" Margin="0" CornerRadius="24" Background="{DynamicResource M3SurfaceBrush}" BorderThickness="0" BorderBrush="Transparent">
        <Grid x:Name="RootContainerGrid">
            <!-- Main Content Container -->
            <Grid x:Name="MainContentGrid" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Settings Scrollable Body -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Header: Full-width draggable, dynamic vector SVG logo, Navigation Tabs, and Preview Toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseDown="Header_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dynamic Vector Panak SVG Logo (svg/settings.svg) -->
                        <Viewbox Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="88" Height="88" Clip="M 0,0 L 88,0 L 88,88 L 0,88 Z">
                                <!-- 1. Scalloped container badge base -->
